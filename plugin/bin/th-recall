#!/bin/sh
# Thalamus recall launcher for the UserPromptSubmit hook of Claude Code.
# It runs th-hook recall with the hook payload on stdin. It never blocks the
# prompt: when the binary or the settings are missing, it exits 0 silently.
#
#   TH_GATEWAY   base URL of the gateway, for example http://gateway.internal:8787
#   TH_KEY       the key the gateway issued to you
#   TH_HOOK_BIN  the th-hook binary (default: next to this launcher)
set -u
bin="${TH_HOOK_BIN:-$(cd "$(dirname "$0")" 2>/dev/null && pwd)/th-hook}"
[ -x "$bin" ] || exit 0
[ -n "${TH_GATEWAY:-}" ] && [ -n "${TH_KEY:-}" ] || exit 0
exec "$bin" recall
